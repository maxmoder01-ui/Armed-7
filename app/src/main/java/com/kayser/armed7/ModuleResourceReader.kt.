
package com.kayser.armed7

import android.content.Context
import java.io.ByteArrayOutputStream
import java.io.File
import java.io.FileInputStream

class ModuleResourceReader(context: Context) {

    private val modulesDirectory =
        File(context.filesDir, "modules").canonicalFile

    data class ResourceInfo(
        val path: String,
        val size: Long,
        val extension: String
    )

    fun listResources(moduleId: String): List<ResourceInfo> {
        val root = getModuleDirectory(moduleId)
        val resources = mutableListOf<ResourceInfo>()

        val allowedRoots = listOf(
            File(root, "assets"),
            File(root, "resources")
        )

        for (directory in allowedRoots) {
            if (!directory.isDirectory) continue

            directory.walkTopDown()
                .filter { it.isFile }
                .forEach { file ->
                    if (resources.size >= MAX_FILES) {
                        error("Limite de arquivos excedido.")
                    }

                    val relative = file.relativeTo(root).invariantSeparatorsPath
                    val extension = file.extension.lowercase()

                    if (extension !in ALLOWED_EXTENSIONS) {
                        return@forEach
                    }

                    validatePath(root, file)

                    resources.add(
                        ResourceInfo(
                            path = relative,
                            size = file.length(),
                            extension = extension
                        )
                    )
                }
        }

        return resources.sortedBy { it.path }
    }

    fun readText(
        moduleId: String,
        relativePath: String
    ): String {
        val file = getResourceFile(moduleId, relativePath)

        require(file.extension.lowercase() in TEXT_EXTENSIONS) {
            "Este arquivo não é um recurso de texto permitido."
        }

        val bytes = readBounded(file, MAX_TEXT_BYTES)

        return bytes.toString(Charsets.UTF_8)
    }

    fun readBytes(
        moduleId: String,
        relativePath: String
    ): ByteArray {
        val file = getResourceFile(moduleId, relativePath)

        require(file.extension.lowercase() in IMAGE_EXTENSIONS) {
            "Formato de imagem não permitido."
        }

        return readBounded(file, MAX_IMAGE_BYTES)
    }

    private fun getResourceFile(
        moduleId: String,
        relativePath: String
    ): File {
        val root = getModuleDirectory(moduleId)

        require(
            relativePath.startsWith("assets/") ||
            relativePath.startsWith("resources/")
        ) {
            "Recurso fora das pastas permitidas."
        }

        require(
            !relativePath.startsWith("/") &&
            !relativePath.contains("\\") &&
            !relativePath.contains(":") &&
            !relativePath.contains('\u0000')
        ) {
            "Caminho inválido."
        }

        val parts = relativePath.split("/")

        require(parts.none {
            it.isBlank() || it == "." || it == ".."
        }) {
            "Caminho inseguro."
        }

        val file = File(root, relativePath)

        validatePath(root, file)

        require(file.isFile) {
            "Recurso não encontrado."
        }

        return file
    }

    private fun getModuleDirectory(id: String): File {
        require(id.matches(ID_PATTERN)) {
            "ID de módulo inválido."
        }

        val root = File(modulesDirectory, id).canonicalFile

        require(root.parentFile == modulesDirectory) {
            "Diretório de módulo inseguro."
        }

        require(root.isDirectory) {
            "Módulo não instalado."
        }

        require(File(root, "manifest.json").isFile) {
            "Manifesto do módulo não encontrado."
        }

        return root
    }

    private fun validatePath(root: File, file: File) {
        val canonicalRoot = root.canonicalFile
        val canonicalFile = file.canonicalFile

        require(
            canonicalFile.path.startsWith(
                canonicalRoot.path + File.separator
            )
        ) {
            "Acesso fora do diretório do módulo bloqueado."
        }
    }

    private fun readBounded(
        file: File,
        limit: Long
    ): ByteArray {
        require(file.length() in 1..limit) {
            "Arquivo vazio ou acima do limite permitido."
        }

        val output = ByteArrayOutputStream()
        val buffer = ByteArray(8192)
        var total = 0L

        FileInputStream(file).use { input ->
            while (true) {
                val count = input.read(buffer)
                if (count == -1) break

                total += count

                require(total <= limit) {
                    "Arquivo excede o limite permitido."
                }

                output.write(buffer, 0, count)
            }
        }

        return output.toByteArray()
    }

    companion object {
        private val ID_PATTERN =
            Regex("[a-z0-9._-]{2,64}")

        private const val MAX_FILES = 500
        private const val MAX_TEXT_BYTES = 1024L * 1024L
        private const val MAX_IMAGE_BYTES = 5L * 1024L * 1024L

        private val TEXT_EXTENSIONS = setOf("json", "txt")
        private val IMAGE_EXTENSIONS = setOf(
            "png", "webp", "jpg", "jpeg"
        )

        private val ALLOWED_EXTENSIONS =
            TEXT_EXTENSIONS + IMAGE_EXTENSIONS
    }
}
